import os
import discord
from discord.ext import commands

TOKEN = os.getenv("DISCORD_TOKEN")

intents = discord.Intents.default()
bot = commands.Bot(command_prefix="!", intents=intents)


@bot.event
async def on_ready():
    print(f"RWAVES BOT PRO online como {bot.user}")


@bot.command()
async def status(ctx):
    await ctx.send(
        "🐘 RWAVES BOT PRO está online!\n"
        "📊 Sistema de análise estatística iniciado."
    )


@bot.command()
async def ajuda(ctx):
    await ctx.send(
        "🤖 RWAVES BOT PRO\n\n"
        "!status — Verificar o estado do bot\n"
        "!ajuda — Consultar os comandos disponíveis"
    )


if not TOKEN:
    raise RuntimeError("A variável DISCORD_TOKEN não foi configurada.")

bot.run(TOKEN)
